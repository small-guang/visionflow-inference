# 复制为 .env；release.sh build 会在交付目录自动填入候选镜像。
# 发布成功后，交付目录中的此值自动固定为仓库 digest。
# 例如 registry.cn-hangzhou.aliyuncs.com/eapil/camtellsvi-triton:1.0.0-jetson-orin-l4t39.2
TRITON_IMAGE=

# all 表示本镜像内的全部服务，或填写一个/多个逗号分隔的 alias；空值会被拒绝。
# 当前发布版不包含 adaface、osnet、sixdrepnet。
# clip_image, clip_text, face_keypoint_2d106, face_qa, face_recognition,
# sbs, tbps_clip_image, tbps_clip_text,
# yolo26m_pose, yolo26s_seg, yolov8n_face
TRITON_MODEL_SET=all

# Jetson 默认使用 GPU 包装器；pose/seg 跨请求合批 B≤4，不额外等待。
# 显式留空选择 CPU 前后处理基线；该基线不作为默认 GPU 发布验收。
TRITON_MODEL_CONFIG=orin_gpu

TRITON_BIND_ADDRESS=0.0.0.0
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8003
TRITON_LOG_MAX_SIZE=100M
TRITON_LOG_BACKUP_COUNT=5
TZ=Asia/Shanghai
