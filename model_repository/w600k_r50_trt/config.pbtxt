name: "w600k_r50_trt"
backend: "tensorrt"
max_batch_size: 4

input [
  {
    name: "input.1"
    data_type: TYPE_FP32
    dims: [3, 112, 112]
  }
]

output [
  {
    name: "683"
    data_type: TYPE_FP32
    dims: [512]
  }
]

instance_group { kind: KIND_GPU count: 1 }
default_model_filename: "model_throughput.plan"

dynamic_batching {
  max_queue_delay_microseconds: 2000
}
