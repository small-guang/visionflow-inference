name: "face_keypoint_2d106"
backend: "tensorrt"
default_model_filename: "model_throughput.plan"
max_batch_size: 4
input [
  {
    name: "data"
    data_type: TYPE_FP32
    dims: [ 3, 192, 192 ]
  }
]
output [
  {
    name: "fc1"
    data_type: TYPE_FP32
    dims: [ 212 ]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 2000
}
