name: "face_qa_ensemble"
platform: "ensemble"
max_batch_size: 4
parameters: {
  key: "api_contract_version"
  value: {
    string_value: "2"
  }
}
input [
  {
    name: "RAW_FACE_IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  },
  {
    name: "LANDMARK"
    data_type: TYPE_FP32
    dims: [ 5, 2 ]
  }
]
output [
  {
    name: "quality_score"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]
ensemble_scheduling {
  step [
    {
      model_name: "face_qa_pre"
      model_version: -1
      input_map {
        key: "RAW_FACE_IMAGE"
        value: "RAW_FACE_IMAGE"
      }
      input_map {
        key: "LANDMARK"
        value: "LANDMARK"
      }
      output_map {
        key: "QA_PREPROCESSED_IMAGE"
        value: "qa_preprocessed_image"
      }
    },
    {
      model_name: "face_qa"
      model_version: -1
      input_map {
        key: "input"
        value: "qa_preprocessed_image"
      }
      output_map {
        key: "quality"
        value: "quality_tensor"
      }
    },
    {
      model_name: "face_qa_postprocess"
      model_version: -1
      input_map {
        key: "quality"
        value: "quality_tensor"
      }
      output_map {
        key: "quality_score"
        value: "quality_score"
      }
    }
  ]
}
