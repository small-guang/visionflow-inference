name: "osnet_ain_x1_0_image_ensemble"
platform: "ensemble"
max_batch_size: 4

input {
  name: "IMAGE_BYTES"
  data_type: TYPE_UINT8
  dims: [-1]
}

output {
  name: "embedding"
  data_type: TYPE_FP32
  dims: [512]
}

ensemble_scheduling {
  step {
    model_name: "osnet_ain_x1_0_image_preprocess"
    model_version: -1
    input_map {
      key: "IMAGE_BYTES"
      value: "IMAGE_BYTES"
    }
    output_map {
      key: "image"
      value: "preprocessed_image"
    }
  }
  step {
    model_name: "osnet_ain_x1_0_onnx"
    model_version: -1
    input_map {
      key: "image"
      value: "preprocessed_image"
    }
    output_map {
      key: "embedding"
      value: "embedding"
    }
  }
}
