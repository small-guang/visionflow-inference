name: "adaface_ir50_webface4m_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 4

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [3, 112, 112]
  }
]

output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [512]
  }
]

instance_group {
  name: "adaface_ir50_webface4m_onnx"
  kind: KIND_GPU
  count: 1
  gpus: [0]
}

default_model_filename: "model.onnx"

dynamic_batching {
  max_queue_delay_microseconds: 2000
}
