name: "yolo26s_seg_ensemble"
platform: "ensemble"
max_batch_size: 4
parameters: {
  key: "api_contract_version"
  value: {
    string_value: "3"
  }
}
input [
  {
    name: "RAW_IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]
output [
  {
    name: "DETECTIONS"
    data_type: TYPE_FP32
    dims: [ -1, 6 ]
  },
  {
    name: "MASK_CROPS_PACKED"
    data_type: TYPE_UINT8
    dims: [ -1, 160, 20 ]
  },
  {
    name: "NUM_DETECTIONS"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]
ensemble_scheduling {
  step [
    {
      model_name: "yolo26s_seg_preprocess"
      model_version: -1
      input_map {
        key: "RAW_IMAGE"
        value: "RAW_IMAGE"
      }
      output_map [
        { key: "PREPROCESSED_IMAGE" value: "preprocessed_image" },
        { key: "LETTERBOX_META" value: "letterbox_meta" }
      ]
    },
    {
      model_name: "yolo26s_seg_onnx"
      model_version: -1
      input_map {
        key: "images"
        value: "preprocessed_image"
      }
      output_map [
        { key: "output0" value: "raw_yolo_output" },
        { key: "output1" value: "mask_proto" }
      ]
    },
    {
      model_name: "yolo26s_seg_postprocess"
      model_version: -1
      input_map [
        { key: "RAW_OUTPUT" value: "raw_yolo_output" },
        { key: "MASK_PROTO" value: "mask_proto" },
        { key: "LETTERBOX_META" value: "letterbox_meta" }
      ]
      output_map [
        { key: "DETECTIONS" value: "DETECTIONS" },
        { key: "MASK_CROPS_PACKED" value: "MASK_CROPS_PACKED" },
        { key: "NUM_DETECTIONS" value: "NUM_DETECTIONS" }
      ]
    }
  ]
}
