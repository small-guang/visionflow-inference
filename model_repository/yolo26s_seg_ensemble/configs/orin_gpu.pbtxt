# Selected by TRITON_MODEL_CONFIG=orin_gpu on Jetson AGX Orin.
# One Python process owns CUDA preprocessing, TensorRT and postprocessing.
name: "yolo26s_seg_ensemble"
backend: "python"
max_batch_size: 4
# Merge already queued, same-shape requests without an additional wait window.
dynamic_batching {}
parameters { key: "api_contract_version" value { string_value: "3" } }
parameters { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value { string_value: "yes" } }
input [
  { name: "RAW_IMAGE" data_type: TYPE_UINT8 dims: [ -1, -1, 3 ] }
]
output [
  { name: "DETECTIONS" data_type: TYPE_FP32 dims: [ -1, 6 ] },
  { name: "MASK_CROPS_PACKED" data_type: TYPE_UINT8 dims: [ -1, 160, 20 ] },
  { name: "NUM_DETECTIONS" data_type: TYPE_INT32 dims: [ 1 ] }
]
instance_group [ { count: 2 kind: KIND_GPU } ]
