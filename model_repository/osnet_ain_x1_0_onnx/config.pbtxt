name: "osnet_ain_x1_0_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 4
input { name: "image" data_type: TYPE_FP32 dims: [3, 256, 128] }
output { name: "embedding" data_type: TYPE_FP32 dims: [512] }
instance_group {
  name: "osnet_ain_x1_0_onnx"
  kind: KIND_GPU
  count: 1
  gpus: [0]
}
default_model_filename: "model.onnx"

dynamic_batching {
  max_queue_delay_microseconds: 2000
}
