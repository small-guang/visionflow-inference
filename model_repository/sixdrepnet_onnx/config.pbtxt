name: "sixdrepnet_onnx"
backend: "onnxruntime"
max_batch_size: 4
input [
  {
    name: "image"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]
  }
]
output [
  {
    name: "rotation_matrix"
    data_type: TYPE_FP32
    dims: [ 3, 3 ]
  }
]
instance_group [
  {
    kind: KIND_GPU
    gpus: [ 0 ]
    count: 1
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 2000
}
