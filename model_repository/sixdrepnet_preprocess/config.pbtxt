name: "sixdrepnet_preprocess"
backend: "python"
max_batch_size: 4
input [
  {
    name: "RAW_FACE_IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]
output [
  {
    name: "PREPROCESSED_IMAGE"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]
  }
]
instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]

dynamic_batching {
}
