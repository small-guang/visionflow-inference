name: "adaface_preprocess"
backend: "python"
max_batch_size: 4

input [
  {
    name: "RAW_IMAGE"
    data_type: TYPE_UINT8
    dims: [-1, -1, 3]
  },
  {
    name: "LANDMARK"
    data_type: TYPE_FP32
    dims: [5, 2]
  }
]

output [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [3, 112, 112]
  }
]

instance_group {
  name: "adaface_preprocess"
  kind: KIND_CPU
  count: 1
}

dynamic_batching {
}
