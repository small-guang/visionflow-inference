name: "face_keypoint_2d106_ensemble"
platform: "ensemble"
max_batch_size: 4
parameters: {
  key: "api_contract_version"
  value: {
    string_value: "1"
  }
}
input [
  {
    name: "RAW_IMAGE"
    data_type: TYPE_UINT8
    # OpenCV BGR image in HWC layout.
    dims: [ -1, -1, 3 ]
  },
  {
    name: "BBOX"
    data_type: TYPE_FP32
    dims: [ 4 ]
  }
]
output [
  {
    name: "LANDMARKS_106"
    data_type: TYPE_FP32
    dims: [ 106, 2 ]
  }
]
ensemble_scheduling {
  step [
    {
      model_name: "face_keypoint_2d106_pre"
      model_version: -1
      input_map [
        { key: "RAW_IMAGE" value: "RAW_IMAGE" },
        { key: "BBOX" value: "BBOX" }
      ]
      output_map [
        { key: "PREPROCESSED_IMAGE" value: "preprocessed_image" },
        { key: "AFFINE_MATRIX" value: "affine_matrix" }
      ]
    },
    {
      model_name: "face_keypoint_2d106"
      model_version: -1
      input_map {
        key: "data"
        value: "preprocessed_image"
      }
      output_map {
        key: "fc1"
        value: "raw_model_output"
      }
    },
    {
      model_name: "face_keypoint_2d106_post"
      model_version: -1
      input_map [
        { key: "RAW_OUTPUT" value: "raw_model_output" },
        { key: "AFFINE_MATRIX" value: "affine_matrix" }
      ]
      output_map {
        key: "LANDMARKS_106"
        value: "LANDMARKS_106"
      }
    }
  ]
}
