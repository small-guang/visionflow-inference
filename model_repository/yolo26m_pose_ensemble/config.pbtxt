name: "yolo26m_pose_ensemble"
platform: "ensemble"
max_batch_size: 4
parameters: {
  key: "api_contract_version"
  value: {
    string_value: "2"
  }
}
input [
  {
    name: "RAW_IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]
output [
  {
    name: "DETECTIONS"
    data_type: TYPE_FP32
    dims: [ 100, 6 ]
  },
  {
    name: "KEYPOINTS"
    data_type: TYPE_FP32
    dims: [ 100, 17, 3 ]
  },
  {
    name: "NUM_DETECTIONS"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]
ensemble_scheduling {
  step [
    {
      model_name: "yolo26m_pose_preprocess"
      model_version: -1
      input_map {
        key: "RAW_IMAGE"
        value: "RAW_IMAGE"
      }
      output_map [
        { key: "PREPROCESSED_IMAGE" value: "preprocessed_image" },
        { key: "LETTERBOX_META" value: "letterbox_meta" }
      ]
    },
    {
      model_name: "yolo26m_pose_onnx"
      model_version: -1
      input_map {
        key: "images"
        value: "preprocessed_image"
      }
      output_map {
        key: "output0"
        value: "raw_yolo_output"
      }
    },
    {
      model_name: "yolo26m_pose_postprocess"
      model_version: -1
      input_map [
        { key: "RAW_OUTPUT" value: "raw_yolo_output" },
        { key: "LETTERBOX_META" value: "letterbox_meta" }
      ]
      output_map [
        { key: "DETECTIONS" value: "DETECTIONS" },
        { key: "KEYPOINTS" value: "KEYPOINTS" },
        { key: "NUM_DETECTIONS" value: "NUM_DETECTIONS" }
      ]
    }
  ]
}
