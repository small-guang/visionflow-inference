name: "TBPS_clip_text_trt"
backend: "tensorrt"
max_batch_size: 4

input {
  name: "text"
  data_type: TYPE_INT64
  dims: [77]
}

output {
  name: "text_feat"
  data_type: TYPE_FP32
  dims: [512]
}

instance_group {
  name: "TBPS_clip_text_enc_onnx"
  kind: KIND_GPU
  count: 1
  gpus: [0]
}

default_model_filename: "model_throughput.plan"

dynamic_batching {
  max_queue_delay_microseconds: 2000
}
