name: "sbs_r50_ibn_image_ensemble"
platform: "ensemble"
max_batch_size: 4
parameters: {
  key: "api_contract_version"
  value: {
    string_value: "2"
  }
}

input {
  name: "IMAGE_BYTES"
  data_type: TYPE_STRING
  dims: [1]
}

output {
  name: "embedding"
  data_type: TYPE_FP32
  dims: [2048]
}

ensemble_scheduling {
  step {
    model_name: "sbs_r50_ibn_image_preprocess"
    model_version: -1
    input_map {
      key: "IMAGE_BYTES"
      value: "IMAGE_BYTES"
    }
    output_map {
      key: "image"
      value: "preprocessed_image"
    }
  }
  step {
    model_name: "sbs_r50_ibn_onnx"
    model_version: -1
    input_map {
      key: "image"
      value: "preprocessed_image"
    }
    output_map {
      key: "embedding"
      value: "embedding"
    }
  }
}
