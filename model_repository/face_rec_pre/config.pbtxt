# config.pbtxt
name: "face_rec_pre"
backend: "python"
max_batch_size: 4
input [
  {
    name: "raw_image"
    data_type: TYPE_UINT8
    dims: [-1, -1, 3]  # 可变尺寸HWC格式
  },
  {
    name: "landmark"
    data_type: TYPE_FP32
    dims: [5, 2]  # 5个关键点，每个点x,y坐标
  }
]
output [
  {
    name: "processed_input"
    data_type: TYPE_FP32
    dims: [3, 112, 112]  # 输出CHW格式
  }
]
instance_group { count: 1 }  # 并行实例数

dynamic_batching {
}
