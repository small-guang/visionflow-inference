name: "yolo26m_pose_preprocess"
backend: "python"
max_batch_size: 4
input [
  {
    name: "RAW_IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]
output [
  {
    name: "PREPROCESSED_IMAGE"
    data_type: TYPE_FP32
    dims: [ 3, -1, -1 ]
  },
  {
    name: "LETTERBOX_META"
    data_type: TYPE_FP32
    dims: [ 7 ]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

dynamic_batching {
}
