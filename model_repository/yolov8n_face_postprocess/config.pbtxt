name: "yolov8n_face_postprocess"
backend: "python"
max_batch_size: 4
input [
  {
    name: "RAW_OUTPUT"
    data_type: TYPE_FP32
    dims: [ 5, -1 ]
  },
  {
    name: "LETTERBOX_META"
    data_type: TYPE_FP32
    dims: [ 5 ]
  }
]
output [
  {
    name: "DETECTIONS"
    data_type: TYPE_FP32
    dims: [ 100, 6 ]
  },
  {
    name: "NUM_DETECTIONS"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

dynamic_batching {
}
