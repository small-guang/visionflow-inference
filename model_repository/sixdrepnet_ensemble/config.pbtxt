name: "sixdrepnet_ensemble"
platform: "ensemble"
max_batch_size: 4
parameters: {
  key: "api_contract_version"
  value: {
    string_value: "1"
  }
}
input [
  {
    name: "RAW_FACE_IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]
output [
  {
    name: "HEAD_POSE"
    data_type: TYPE_FP32
    dims: [ 3 ]
  }
]
ensemble_scheduling {
  step [
    {
      model_name: "sixdrepnet_preprocess"
      model_version: -1
      input_map {
        key: "RAW_FACE_IMAGE"
        value: "RAW_FACE_IMAGE"
      }
      output_map {
        key: "PREPROCESSED_IMAGE"
        value: "preprocessed_image"
      }
    },
    {
      model_name: "sixdrepnet_onnx"
      model_version: -1
      input_map {
        key: "image"
        value: "preprocessed_image"
      }
      output_map {
        key: "rotation_matrix"
        value: "rotation_matrix"
      }
    },
    {
      model_name: "sixdrepnet_postprocess"
      model_version: -1
      input_map {
        key: "ROTATION_MATRIX"
        value: "rotation_matrix"
      }
      output_map {
        key: "HEAD_POSE"
        value: "HEAD_POSE"
      }
    }
  ]
}
