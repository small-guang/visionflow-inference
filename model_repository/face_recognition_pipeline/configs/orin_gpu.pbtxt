name: "face_recognition_pipeline"
backend: "python"
max_batch_size: 4
parameters { key: "api_contract_version" value { string_value: "1" } }
parameters { key: "pipeline_backend" value { string_value: "orin_gpu" } }
parameters { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value { string_value: "yes" } }
input [
  { name: "RAW_IMAGE" data_type: TYPE_UINT8 dims: [ -1, -1, 3 ] allow_ragged_batch: true },
  { name: "LANDMARK" data_type: TYPE_FP32 dims: [ 5, 2 ] }
]
output [ { name: "EMBEDDING" data_type: TYPE_FP32 dims: [ 512 ] } ]
instance_group [ { kind: KIND_GPU count: 2 } ]
dynamic_batching { preferred_batch_size: [ 4 ] max_queue_delay_microseconds: 250 }
