name: "face_recognition_pipeline"
platform: "ensemble"
max_batch_size: 4
parameters: {
  key: "api_contract_version"
  value: {
    string_value: "1"
  }
}
input [
  {
    name: "RAW_IMAGE"
    data_type: TYPE_UINT8
    dims: [-1, -1, 3]  # 可变尺寸输入
  },
  {
    name: "LANDMARK"
    data_type: TYPE_FP32
    dims: [5, 2]  # 5个关键点，每个点x,y坐标
  }
]
output [
  {
    name: "EMBEDDING"
    data_type: TYPE_FP32
    dims: [512]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "face_rec_pre"
      model_version: -1
      input_map [
        { key: "raw_image" value: "RAW_IMAGE" },
        { key: "landmark" value: "LANDMARK" }
      ]
      output_map { key: "processed_input" value: "preprocessed_data" }
    },
    {
      model_name: "w600k_r50_trt"
      model_version: -1
      input_map { key: "input.1" value: "preprocessed_data" }
      output_map { key: "683" value: "EMBEDDING" }
    }
  ]
}
