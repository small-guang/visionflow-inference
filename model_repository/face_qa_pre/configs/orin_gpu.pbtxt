# Explicit GPU preprocessing; the default config keeps the CPU reference.
name: "face_qa_pre"
backend: "python"
max_batch_size: 4
input [
  {
    name: "RAW_FACE_IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  },
  {
    name: "LANDMARK"
    data_type: TYPE_FP32
    dims: [ 5, 2 ]
  }
]
output [
  {
    name: "QA_PREPROCESSED_IMAGE"
    data_type: TYPE_FP32
    dims: [ 3, 112, 112 ]
  }
]

instance_group {
  count: 1 kind: KIND_GPU
}

dynamic_batching {
}

parameters { key: "preprocess_backend" value { string_value: "orin_gpu" } }
parameters { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value { string_value: "yes" } }
