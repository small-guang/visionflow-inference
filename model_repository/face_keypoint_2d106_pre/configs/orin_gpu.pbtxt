# Explicit GPU preprocessing; the default config keeps the CPU reference.
name: "face_keypoint_2d106_pre"
backend: "python"
max_batch_size: 4
input [
  {
    name: "RAW_IMAGE"
    data_type: TYPE_UINT8
    # OpenCV BGR image in HWC layout.
    dims: [ -1, -1, 3 ]
  },
  {
    name: "BBOX"
    data_type: TYPE_FP32
    dims: [ 4 ]
  }
]
output [
  {
    name: "PREPROCESSED_IMAGE"
    data_type: TYPE_FP32
    dims: [ 3, 192, 192 ]
  },
  {
    name: "AFFINE_MATRIX"
    data_type: TYPE_FP64
    dims: [ 2, 3 ]
  }
]
instance_group [
  {
    count: 1 kind: KIND_GPU
  }
]

dynamic_batching {
}

parameters { key: "preprocess_backend" value { string_value: "orin_gpu" } }
parameters { key: "FORCE_CPU_ONLY_INPUT_TENSORS" value { string_value: "yes" } }
