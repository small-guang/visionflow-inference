name: "adaface_recognition_pipeline"
platform: "ensemble"
max_batch_size: 4

input [
  {
    name: "RAW_IMAGE"
    data_type: TYPE_UINT8
    dims: [-1, -1, 3]
  },
  {
    name: "LANDMARK"
    data_type: TYPE_FP32
    dims: [5, 2]
  }
]

output [
  {
    name: "EMBEDDING"
    data_type: TYPE_FP32
    dims: [512]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "adaface_preprocess"
      model_version: -1
      input_map [
        { key: "RAW_IMAGE" value: "RAW_IMAGE" },
        { key: "LANDMARK" value: "LANDMARK" }
      ]
      output_map { key: "input" value: "adaface_input" }
    },
    {
      model_name: "adaface_ir50_webface4m_onnx"
      model_version: -1
      input_map { key: "input" value: "adaface_input" }
      output_map { key: "embedding" value: "EMBEDDING" }
    }
  ]
}
