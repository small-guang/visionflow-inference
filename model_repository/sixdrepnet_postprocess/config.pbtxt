name: "sixdrepnet_postprocess"
backend: "python"
max_batch_size: 4
input [
  {
    name: "ROTATION_MATRIX"
    data_type: TYPE_FP32
    dims: [ 3, 3 ]
  }
]
output [
  {
    name: "HEAD_POSE"
    data_type: TYPE_FP32
    dims: [ 3 ]
  }
]
instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]

dynamic_batching {
}
