name: "clip_image_trt"
backend: "tensorrt"
max_batch_size: 4

input {
  name: "image"
  data_type: TYPE_FP32
  dims: [3, 224, 224]
}

output {
  name: "unnorm_image_features"
  data_type: TYPE_FP32
  dims: [512]
}

instance_group {
  name: "clip_image_trt"
  kind: KIND_GPU
  count: 1
  gpus: [0]
}

default_model_filename: "model_throughput.plan"

dynamic_batching {
  max_queue_delay_microseconds: 2000
}
